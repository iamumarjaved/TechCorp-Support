{
  "ServiceName": "chatbot-backend",
  "SourceConfiguration": {
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::642570498698:role/service-role/AppRunnerECRAccessRole"
    },
    "ImageRepository": {
      "ImageIdentifier": "642570498698.dkr.ecr.ap-south-1.amazonaws.com/chatbot-backend:latest",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "8000",
        "RuntimeEnvironmentVariables": {
          "OPENAI_API_KEY": "${OPENAI_API_KEY}",
          "MCP_SERVER_URL": "https://vipfapwm3x.us-east-1.awsapprunner.com/mcp",
          "LLM_MODEL": "gpt-4o-mini",
          "DEBUG": "false",
          "CORS_ORIGINS": "*"
        }
      }
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}
